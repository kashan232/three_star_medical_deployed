<IfModule mod_rewrite.c>
    <IfModule mod_negotiation.c>
        Options -MultiViews -Indexes
    </IfModule>

    RewriteEngine On

    # Stop rewriting if already in public/
    RewriteRule ^public/ - [L]

    # Rewrite all other requests to public/
    RewriteCond %{REQUEST_URI} !^/public/
    RewriteRule ^(.*)$ public/$1 [L,QSA]
</IfModule>

# Set DirectoryIndex
DirectoryIndex public/index.php index.php

# Security: Deny direct access to sensitive files
<FilesMatch "^\.(env|git|env\..*)">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>

<FilesMatch "(composer\.(json|lock)|package\.json|package-lock\.json|artisan|\.gitignore|\.gitattributes)">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>
